# Multimodal AI Ingestion Engine — environment template.
# Copy to `.env` and fill in values. `.env` is gitignored (never commit real keys).

# --- Service ---
INGEST_ENVIRONMENT=development

# --- Capacity guardrails (defaults sized for 8GB / 8-core host) ---
# INGEST_MAX_FILE_SIZE_BYTES=104857600
# INGEST_UPLOAD_DIR=/tmp/multimodal-ingestion/uploads
# INGEST_RESULT_DIR=/tmp/multimodal-ingestion/results

# --- Concurrency / memory plan (single source of truth for docker-compose) ---
# Worst-case queue footprint = concurrency x child limit; it must fit the
# container cap defined in app/config.py (validated at startup).
# INGEST_INGESTION_CONCURRENCY=2      # 2 x 1024MB inside the 2g worker cap
# INGEST_MEDIA_CONCURRENCY=2          # 2 x 384MB inside the 1g media cap
# INGEST_INDEX_CONCURRENCY=1          # 1 x 768MB inside the 1g index cap
# INGEST_REASONING_CONCURRENCY=1      # 1 child inside the 512m reasoning cap
# INGEST_WORKER_CHILD_MEMORY_LIMIT_MB=1024   # ingestion child limit (per container)
# INGEST_WORKER_MEMORY_BUDGET_MB=2048        # ingestion worker budget (= its 2g cap)
# INGEST_MEDIA_CHILD_MEMORY_LIMIT_MB=384
# INGEST_INDEX_CHILD_MEMORY_LIMIT_MB=768
# INGEST_REASONING_CHILD_MEMORY_LIMIT_MB=512
# INGEST_WORKER_MAX_TASKS_PER_CHILD=20
# INGEST_MEDIA_MAX_TASKS_PER_CHILD=10

# --- Redis / Celery ---
INGEST_REDIS_URL=redis://localhost:6379/0

# --- Phase 3: vector database ---
INGEST_QDRANT_URL=http://localhost:6333
# Embedding device policy (requires `pip install torch` for mps/cuda).
# auto = CUDA > MPS (16GB+ hosts only) > CPU; force with cpu|mps|cuda.
# INGEST_EMBEDDING_DEVICE=auto
# INGEST_ACCELERATOR_MIN_HOST_MEMORY_MB=16384

# --- Phase 4: reasoning core ---
# auto | local | openai | anthropic
INGEST_REASONING_BACKEND=auto
INGEST_OPENAI_API_KEY=
INGEST_ANTHROPIC_API_KEY=
# Opt-in local quantized backbone (requires llama-cpp-python + a .gguf model):
INGEST_LOCAL_LLM_ENABLED=false
# INGEST_LOCAL_LLM_MODEL_PATH=/models/mistral-7b-instruct.Q4_K_M.gguf
